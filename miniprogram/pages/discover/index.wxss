.tonight { padding-bottom: 160rpx; }
.brand-bar { background: var(--canvas); }
.brand { display: flex; align-items: center; gap: 22rpx; margin: 0 40rpx; }
.brand-name { font-size: 36rpx; font-weight: 600; letter-spacing: 9rpx; }
.brand-en { font-size: 11rpx; letter-spacing: 6rpx; margin-top: 8rpx; }
.record { width: 48rpx; height: 48rpx; border: 2rpx solid #d7dbc8; border-radius: 50%; display: flex; align-items: center; justify-content: center; transform: rotate(-22deg); position: relative; }
.record::after { content: ''; position: absolute; inset: 8rpx; border: 2rpx solid transparent; border-left-color: #d7dbc8; border-right-color: #d7dbc8; border-radius: 50%; }
.record-hole { width: 7rpx; height: 7rpx; background: #d7dbc8; border-radius: 50%; }
.onair { margin: 20rpx 40rpx 0; padding: 20rpx 0; border-top: 1rpx solid var(--line); display: flex; justify-content: space-between; font-size: 12rpx; letter-spacing: 2rpx; color: var(--muted); }
.onair text:first-child { color: #e2b28a; }
.hero { height: 490rpx; position: relative; overflow: hidden; }
.hero-image { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .8; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg,#14231ef5 0%,#14231e99 42%,#14231e08 90%),linear-gradient(0deg,#14231e 0%,transparent 45%); }
.hero-copy { position: absolute; left: 42rpx; top: 45rpx; }
.hero-kicker { font-size: 12rpx; letter-spacing: 3rpx; }
.hero-title { font-family: 'Songti SC', 'STSong', serif; font-size: 58rpx; font-weight: 400; letter-spacing: 2rpx; line-height: 1.55; margin: 36rpx 0 26rpx; }
.hero-intro { font-size: 21rpx; line-height: 2; color: #d0d0bb; }
.handwritten { position: absolute; right: 32rpx; bottom: 86rpx; font: italic 29rpx Georgia,serif; color: var(--accent); transform: rotate(-9deg); }
.playing { position: absolute; bottom: 18rpx; left: 42rpx; right: 42rpx; display: flex; align-items: center; gap: 14rpx; font-size: 12rpx; letter-spacing: 2rpx; color: var(--muted); }
.tiny-record { font-size: 30rpx; }
.track { color: var(--ink); font: italic 22rpx Georgia,serif; letter-spacing: 0; }
.equalizer { margin-left: auto; color: var(--accent); font-size: 30rpx; }
.paper { margin: 34rpx 38rpx 0; padding: 28rpx; background: #eee9da; color: #374337; border-radius: 3rpx; position: relative; }
.tape { width: 82rpx; height: 25rpx; position: absolute; top: -14rpx; left: calc(50% - 41rpx); background: #c1bc9f8c; transform: rotate(-5deg); }
.paper-heading { display: flex; justify-content: space-between; align-items: center; font-size: 12rpx; letter-spacing: 1rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #293d2b33; }
.paper-heading text:last-child { font-size: 16rpx; color: #7c806e; letter-spacing: 0; }
.guest { display: flex; align-items: flex-start; gap: 16rpx; margin: 22rpx 0; }
.guest-label { font-size: 18rpx; color: #7c806e; padding-top: 3rpx; }
.guest-text { border-bottom: 1rpx dashed #53624c66; font-size: 22rpx; padding-bottom: 5rpx; flex: 1; line-height: 1.6; }
.bartender { display: flex; align-items: flex-start; gap: 16rpx; }
.bartender-icon { width: 48rpx; height: 48rpx; background: #d5dac9; border: 1rpx solid #35422c44; border-radius: 50%; text-align: center; line-height: 44rpx; font-size: 34rpx; }
.bartender-copy { flex: 1; min-width: 0; }
.bartender-label { font-size: 17rpx; color: #6e7560; }
.answer { font-size: 24rpx; line-height: 1.9; margin-top: 6rpx; }
.prompts { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.prompts button { border: 1rpx solid #46543c44; color: #4e5a46; font-size: 18rpx; line-height: 1.4; padding: 10rpx 14rpx; border-radius: 30rpx; background: transparent; }
.restart { background: transparent; color: #58634e; font-size: 20rpx; padding: 10rpx 0 0; text-align: right; }
.tonight-menu { margin: 46rpx 42rpx 0; }
.menu-heading { display: flex; justify-content: space-between; align-items: flex-end; }
.menu-kicker { color: var(--muted); font-size: 12rpx; letter-spacing: 3rpx; }
.menu-title { font-family: 'Songti SC','STSong',serif; font-size: 40rpx; margin-top: 16rpx; letter-spacing: 2rpx; }
.menu-count { color: var(--muted); font: 22rpx Georgia,serif; }
.filters { display: flex; gap: 28rpx; margin-top: 22rpx; border-bottom: 1rpx solid var(--line); }
.filters button { padding: 16rpx 0; border-radius: 0; color: var(--muted); background: transparent; font-size: 22rpx; line-height: 1.5; border-bottom: 3rpx solid transparent; }
.filters .active { color: var(--accent); border-bottom-color: var(--accent); }
.filters .menu-link { margin-left: auto; }
.menu-drink { display: flex; align-items: center; gap: 16rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.drink-open { display: flex; align-items: center; gap: 22rpx; padding: 0; background: transparent; color: var(--ink); text-align: left; flex: 1; min-width: 0; line-height: 1.4; }
.drink-photo { width: 136rpx; height: 150rpx; position: relative; border-radius: 5rpx; overflow: hidden; flex-shrink: 0; }
.drink-photo image { width: 100%; height: 100%; }
.drink-photo text { position: absolute; bottom: 0; left: 0; padding: 5rpx 9rpx; font-size: 12rpx; letter-spacing: 2rpx; background: #e7dfcb; color: #354233; }
.drink-info { min-width: 0; flex: 1; }
.drink-label { color: var(--accent); font-size: 10rpx; letter-spacing: 2rpx; }
.drink-title { font: 34rpx 'Songti SC','STSong',serif; margin: 12rpx 0 10rpx; letter-spacing: 1rpx; }
.drink-note { color: var(--muted); font-size: 18rpx; line-height: 1.6; }
.drink-meta { color: #98a393; font-size: 17rpx; margin-top: 10rpx; }
.drink-action { display: flex; flex-direction: column; align-items: flex-end; gap: 18rpx; }
.drink-price { font: 38rpx Georgia,serif; }
.drink-price text { font-size: 22rpx; margin-right: 3rpx; }
.add-button { border: 1rpx solid var(--line); border-radius: 50%; color: var(--accent); width: 60rpx; height: 60rpx; line-height: 56rpx; font-size: 38rpx; padding: 0; background: transparent; }
.menu-end { display: flex; justify-content: space-between; gap: 10rpx; padding: 28rpx 0; color: #98a393; font-size: 13rpx; }
.menu-end text:last-child { font-size: 11rpx; letter-spacing: 2rpx; }
.mock-label { color: #a1ad9c; font-size: 19rpx; text-align: center; padding-bottom: 20rpx; }
.composer-wrap { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; padding: 20rpx 38rpx; background: #14231ef5; border-top: 1rpx solid var(--line); }
.composer { display: flex; align-items: center; gap: 18rpx; padding: 12rpx 14rpx 12rpx 22rpx; background: #ffffff08; border: 1rpx solid #ffffff33; border-radius: 8rpx; }
.chat-symbol { color: var(--accent); font-size: 36rpx; }
.composer input { flex: 1; min-width: 0; width: 0; font-size: 23rpx; color: var(--ink); height: 60rpx; }
.composer-placeholder { color: #a2ac99; }
.composer button { background: var(--accent); color: var(--canvas); width: 62rpx; height: 62rpx; line-height: 58rpx; font-size: 42rpx; padding: 0; border-radius: 5rpx; }
.error { margin: 28rpx 38rpx; }
.sheet-mask { position: fixed; inset: 0; background: #0009; z-index: 30; display: flex; align-items: flex-end; }
.drink-sheet { width: 100%; max-height: 85vh; overflow-y: auto; background: #eee9da; color: #374337; border-radius: 24rpx 24rpx 0 0; padding: 28rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); }
.sheet-top { display: flex; align-items: center; justify-content: space-between; color: #67715e; font-size: 22rpx; }
.sheet-top button { color: #374337; background: transparent; font-size: 40rpx; line-height: 1.5; padding: 0 12rpx; }
.sheet-image { margin-top: 18rpx; width: 100%; height: 300rpx; border-radius: 6rpx; }
.sheet-title { font: 42rpx 'Songti SC','STSong',serif; margin: 24rpx 0; }
.sheet-title text { float: right; font: 34rpx Georgia,serif; }
.sheet-ingredients { margin: 20rpx 0; font-size: 26rpx; line-height: 1.8; }
.drink-sheet .muted { color: #67715e; }
.drink-sheet .primary { color: #14231e; }
.bartender-icon image { width: 34rpx; height: 34rpx; margin-top: 5rpx; }
.filters button { display: flex; align-items: center; gap: 8rpx; }
.filter-icon { width: 25rpx; height: 25rpx; }
.chat-symbol { width: 36rpx; height: 36rpx; flex-shrink: 0; }
