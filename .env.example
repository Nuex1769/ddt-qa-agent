# 本地演示无需密钥；使用真实模型时改为 false，并配置下方变量。
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/ddt.db
SESSION_SECRET=local-development-change-before-deployment
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# DEMO_MODE=false 时必须更换 SESSION_SECRET，并设置管理员密码（至少 12 位）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# DeepSeek 官方聊天 API；密钥仅保存在服务端。
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
CHAT_MODEL=deepseek-flash
# auto 对官方 DeepSeek 关闭思考以降低回答延迟；enabled 可开启思考。
CHAT_THINKING=auto

# keyword 无需向量服务；hybrid 需要另行配置下面的 Embedding 服务。
RETRIEVAL_MODE=keyword
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
TOP_K=5
MAX_UPLOAD_MB=20

# 可选：同步运行信息到 Langfuse（不上传问题、回答或文档正文）。
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 用于生成记录详情链接，可从 Langfuse 项目 URL 获取。
LANGFUSE_PROJECT_ID=

# Docker Compose 使用
POSTGRES_PASSWORD=ddt-local-only
